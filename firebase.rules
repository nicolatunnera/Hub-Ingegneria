rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // ═══ UTENTI / ACCOUNT (accountsHub) ═══════════════════════════════
    // LETTURA: consentita a chiunque (necessaria al login anonimo)
    // SCRITTURA: solo utenti autenticati; per creare/aggiornare il proprio
    // profilo si usa il campo username (gestito lato client).
    match /accountsHub/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ═══ FILE EXCEL (excelHub) + blobs chunks ═════════════════════════
    match /excelHub/{fileId} {
      allow read: if true;
      allow write: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.keys().hasAll(['name', 'uploadedAt']);
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ═══ FILE DOCUMENTI (textHub) + blobs chunks ══════════════════════
    // STEP/STP/PDF ecc. — accesso e scrittura come sopra
    match /textHub/{fileId} {
      allow read: if true;
      allow write: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.keys().hasAny(['title', 'fileName']);
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ═══ STORICO ATTIVITÀ ═════════════════════════════════════════════
    match /historyHub/{entryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ═══ CONFIGURAZIONE VARIABASE (categoriesHub, archiveFolders, ecc.) ══
    match /categoriesHub/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /archiveFolders/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /subscribers/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /privateSpaceRequests/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /newsHub/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /notesHub/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}